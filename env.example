# The kit's environment: copy, fill in, and source before running a test (. ./env). Every path comes from
# here; the kit has no idea where KWin, the session bus or the runtime live.

# The session KWin runs in: its bus (the publisher's name is on it) and its Wayland socket.
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
export XDG_RUNTIME_DIR=/run/user/1000
export WAYLAND_DISPLAY=wayland-0

# The output to audit, by KWin's name (kscreen-doctor -o, or tools/outputs.py lists them). Empty: the first.
export AUDIT_OUTPUT=HDMI-A-1

# Where results go, and where tools/build.sh put the C tools.
export AUDIT_OUT=$PWD/out
export AUDIT_BIN=$PWD/build

# A directory KWin reads at the same path as this shell, for KWin scripts (a chroot: one bind-mounted
# into it, such as the runtime directory). Default: XDG_RUNTIME_DIR.
# export AUDIT_SCRIPT_DIR=/run/user/1000

# DisplayXR's test app, for the tests that need the runtime (placement's cube row, dropsnap, movesync,
# handdrag): the run script of a runtime build, or an installed cube_handle_vk_linux.
export DXR_APP=/path/to/displayxr-runtime/build/run_cube_handle_vk_linux.sh
# AUDIT_SIM=1 (default) runs it on sim_display, interlaced, period 5, the audited output as the panel: the
# headless configuration of the runs on DisplayXR/displayxr-runtime#1928. AUDIT_SIM=0 lets the runtime pick
# the real display; the origin stamp (DXR_WL_ORIGIN_STAMP=1) is drawn over the woven frame either way.
export AUDIT_SIM=0
# Extra VAR=VALUE words for the app.
# export DXR_APP_ENV=""

# A displayxr-runtime checkout, so tools/build.sh builds consumer-convert from its own conversion code.
# export DXR_SRC=/path/to/displayxr-runtime

# KWin's log (its stderr, or a journal export), for the move-sync columns that read KWin's own debug
# lines; KWin then needs DISPLAYXR_DEBUG=1 and QT_LOGGING_RULES=kwin_displayxr.debug=true in its environment.
# export AUDIT_KWIN_LOG=$AUDIT_OUT/kwin.log
